// Osysharp.Agents.Testing — testing an agent without a model: a script of what the model answers, turn by turn, and
// what the agent then did, read back from its record.
//
//     var script = AgentScript.Of(
//       Says.Tool(Actions.Of(Weigh), "{\"crate\":\"" + crate.Id + "\"}"),
//       Says.HandBack(new Grade { Score = 4, Short = true }));
//     ScriptedAnswer.Stub((model, request) => script.Answer(model, request));
//
//     var outcome = Agents.Of<Inspector>().Do(new GradeCrate(), crate);
//     Assert.Equal(["Weigh"], Trajectory.Of(outcome.Task));
//
// Everything around the model is real — the loop, the agent's rights, the budget, the meter, the record — so a test
// asserts what the agent DID and what it cost, for nothing, the same on every machine.
package Osysharp.Agents.Testing {
  version     "1.3.0";
  minPlatform "0.14.0";
  summary     "testing agents for free: a script of the model's answers turn by turn (tool calls, the result handed back, words, advice from a consulted model), and the trajectory, models and cost of a piece of work read back from its record; and a cast that scripts several agents at once, with the tree of what they handed on to each other read back.";

  model "model/*.osy";
  use Osysharp.Agents@1;
  use Osysharp.Llm@2;
  tests "tests";
}
