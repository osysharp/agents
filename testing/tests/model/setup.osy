// The lighthouse's models and its one agent. In a file of its own with no `namespace`, because an `app.X = …`
// statement's value is resolved outside the file's namespace.
using Osysharp.Agents;
using Osysharp.Llm;
using Lighthouse;

app.Llm = new LlmSetup {
  Models = [
    new LlmModel { Name = "Lamp",   Client = new ScriptedModel { Name = "Lamp" },   Model = "scripted-lamp",
                   Price = new LlmPrice { Input = 1, Output = 5 }, MaxOutputTokens = 1000 },
    new LlmModel { Name = "Beacon", Client = new ScriptedModel { Name = "Beacon" }, Model = "scripted-beacon",
                   Price = new LlmPrice { Input = 10, Output = 50 }, MaxOutputTokens = 1000 },
  ],
  Default = "Lamp",
};

app.Agents = new AgentsSetup { Agents = [new Mate(), new Lookout(), new Bosun()] };
