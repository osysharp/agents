// The office's screens — the inbox as the WorkQueues kit draws it, where an agent's proposal and its question show as
// requests; the vetter's own page with who it is waiting on; and the page a supplier answers on, behind its link.
namespace Purchasing;

using Osysharp.Identity;
using Osysharp.WorkQueues;
using Osysharp.HumanRequests;
using Osysharp.Agents;
using Osysharp.Agents.HumanRequests;

[Layout]
component OfficeFrame() {
  live var me = Session.CurrentUser;
  live var myName = me == null ? "" : me.DisplayName;
  action SignOut() { Session.SignOut(); }
  action Appearance() { Theme.Toggle(); }
  render {
    InboxShell(new AppChrome {
      Product = "Crumb & Crust",
      Tagline = "Purchasing",
      Mark = Icons.Inbox,
      Home = "/inbox/mine",
      Panes = true,
      User = new ShellUser {
        Name = myName, Initials = InitialsOf(myName == "" ? "?" : myName), Presence = ShellPresence.Online,
        Menu = [
          new MenuAction { Label = "Appearance", Icon = Icons.Eye, OnPress = Appearance },
          new MenuAction { Label = "Sign out", Icon = Icons.Logout, OnPress = SignOut, Tone = Tone.Danger, Divided = true },
        ],
      },
      Nav = [],
    }) {
      Outlet(retain: 4);
    }
  }
}

[Route("/")] [Layout(OfficeFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Inbox")]
component Home() {
  render { InboxPanes("mine", r => "/inbox/mine/i/" + r.Id, Guid.Empty) { InboxOverview("mine"); } }
}

[Route("/inbox/{view}")] [Layout(OfficeFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Inbox")]
component InboxPage(string view) {
  render { InboxPanes(view, r => "/inbox/" + view + "/i/" + r.Id, Guid.Empty) { InboxOverview(view); } }
}

[Route("/inbox/{view}/i/{id}")] [Layout(OfficeFrame)] [Authorize(WorksInbox)] [Render(CSR)] [Title("Item")]
component ItemPage(string view, Guid id) {
  live var items = WorkItem.Where(w => w.Id == id).Include(w => w.Queue).Include(w => w.Assignee).ToList();
  render {
    InboxPanes(view, r => "/inbox/" + view + "/i/" + r.Id, id) {
      Stack(gap: 0, grow: 1, minW: "0", h: "100%", minH: "0", overflowY: Overflow.Auto) {
        if (!Layout.AtLeast(Tablet)) {
          Row(px: 4, pt: 3) { Link(href: "/inbox/" + view, label: "Back to the list") { Icon(Icons.ChevronLeft); } }
        }
        foreach (var item in items) { WorkItemView(item); }
      }
    }
  }
}

/// The vetter's page: who it is waiting on.
[Route("/agents/vetter")] [Layout(OfficeFrame)] [Authorize(SupervisesAgents)] [Render(CSR)] [Title("Vetter")]
component VetterPage() {
  render {
    Stack(gap: 5, p: 5, maxW: "720px") {
      PageHead("Vetter", subtitle: "Vets the companies that apply to supply the bakeries.");
      AgentWaitingOnPeople("Purchasing.Vetter", open: r => "/inbox/open/i/" + r);
    }
  }
}

/// A piece of agent work's own page: the tree of it — who is doing what, where each piece stands, what it has cost —
/// and who it is waiting on.
[Route("/work/{id}")] [Layout(OfficeFrame)] [Authorize(UsesAgents)] [Render(CSR)] [Title("Work")]
component WorkPage(Guid id) {
  render {
    Stack(gap: 5, p: 5, maxW: "820px", w: "100%") {
      PageHead("Agent work", subtitle: "Who is doing what, where each piece stands, and what it has cost.");
      AgentWorkTree(id, open: t => "/work/" + t);
      WorkWaitingOnPeople(id, open: r => "/inbox/mine/i/" + r);
    }
  }
}

/// Where a supplier answers: the page behind the link in the mail the office sent.
[Route("/answer/{link}")] [AllowAnonymous] [Render(CSR)] [Title("A question from Crumb & Crust")]
component AnswerPage(AnswerLink link) {
  render { ExternalAnswer(link); }
}
