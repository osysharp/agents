// The office's agent and its model. In a file of its own with no `namespace`, because an `app.X = …` statement's
// value is resolved outside the file's namespace.
using Osysharp.Agents;
using Osysharp.Agents.HumanRequests;
using Osysharp.Llm;
using Osysharp.WorkQueues;
using Purchasing;

app.Llm = new LlmSetup {
  Models = [
    new LlmModel { Name = "Small", Client = new ScriptedModel { Name = "Small" }, Model = "scripted-small",
                   Price = new LlmPrice { Input = 1, Output = 5 }, MaxOutputTokens = 1000 },
  ],
  Default = "Small",
};

app.Agents = new AgentsSetup {
  Agents = [new Vetter(), new Qualifier(), new FinanceAssessor(), new SafetyAssessor(), new TermsReader()],
  TaskBudget = 0.05m,
};
app.AgentRequests = new AgentRequestsSetup { Queue = "Purchasing", DecideWithin = TimeSpan.FromHours(8) };
app.Inbox = new InboxSetup { DefaultQueue = "Purchasing" };
