// Osysharp.Agents.Processes — an agent's work as a step of a business process, seen from both sides.
//
// A process is a workflow, and an agent's step in it is an ordinary call — nothing here is written at the call:
//
//     state Vetting {
//       enter {
//         var vetted = await Agents.Of<Vetter>().Do(new VetSupplier(), this.Item);     // typed in, typed out
//         if (!vetted.Done) { Processes.Problem("Vetting did not finish: " + vetted.Problem); goto NeedsAPerson; }
//         if (vetted.Result.Recommend) { goto Approved; }
//         goto Declined;
//       }
//     }
//
// With both kits in an app this bridge is there, and:
//
// ⚑ THE RUN TELLS ITS AGENT STEPS. Each piece of work given in a run is a line of that run, in the state that gave
//   it — given, waiting on a person, finished, failed, stopped — and opens in place as the whole inspector.
//
// ⚑ THE WORK TELLS ITS RUN. The inspector of a piece of work says which run of which process it is a step of, and
//   links to it.
//
// ⚑ A RUN IS LISTED BY ITS FIRST AGENT STEP, with nothing written in the workflow; what the run cost is every model
//   call of its agent work and of its own body, against the limit set for each run (`SetProcessBudget`).
package Osysharp.Agents.Processes {
  version     "1.1.0";
  minPlatform "0.14.0";
  summary     "agents inside business processes: each piece of an agent's work given in a workflow's run is told on that run — given, waiting on a person, finished, failed, called off — in the state that gave it, and opens in place as the full inspector; the work's own page says which run of which process it is a step of; a run is listed from its first agent step with nothing written in the workflow; and a table of a run's agent work with what each cost.";
  completes   Osysharp.Agents@1, Osysharp.Processes@1;

  model "model/**/*.osy";
  tests "tests";
  use Osysharp.Agents@1;
  use Osysharp.Agents.Inspector@1;
  use Osysharp.Processes@1;
  use Osysharp.Llm@2;
  use Osysharp.Identity@0;
  use Osysharp.Workflow;
  use Osysharp.Observability;
  use Osysharp.Diagrams@0;
  use Osysharp.Ui;
}
