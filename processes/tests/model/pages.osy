// The office's screens: every qualification, one qualification, and one piece of an agent's work.
namespace Procurement;

using Osysharp.Identity;
using Osysharp.Agents;
using Osysharp.Agents.Inspector;
using Osysharp.Agents.Teaching;
using Osysharp.Processes;

[Layout]
component OfficeFrame() {
  live var me = Session.CurrentUser;
  live var myName = me == null ? "" : me.DisplayName;
  action SignOut() { Session.SignOut(); }
  action Appearance() { Theme.Toggle(); }
  render {
    TabbedShell(new AppChrome {
      Product = "Halden Tools",
      Tagline = "Procurement",
      Mark = Icons.Building,
      Home = "/",
      User = new ShellUser {
        Name = myName, Initials = InitialsOf(myName == "" ? "?" : myName),
        Menu = [
          new MenuAction { Label = "Appearance", Icon = Icons.Eye, OnPress = Appearance },
          new MenuAction { Label = "Sign out", Icon = Icons.Logout, OnPress = SignOut, Tone = Tone.Danger, Divided = true },
        ],
      },
      Nav = [ new NavItem { Label = "Qualifications", To = "/", Icon = Icons.Home, Exact = true } ],
    }) {
      Outlet();
    }
  }
}

string InitialsOf(string name) {
  var initials = "";
  foreach (var part in name.Split(" ")) { if (part != "" && initials.Length < 2) { initials = initials + part.Substring(0, 1).ToUpper(); } }
  return initials;
}

/// Every qualification.
[Route("/")] [Layout(OfficeFrame)] [Authorize(FollowsProcesses)] [Render(CSR)] [Title("Qualifications")]
component QualificationsPage() {
  render {
    Stack(gap: 6, px: 5, py: 6, w: "100%", maxW: "980px", mx: "auto") {
      PageHead("Qualifications", subtitle: "Every supplier on its way to being approved, and where each one stands.");
      ProcessRuns();
    }
  }
}

/// One qualification, from the buyer's request to where it is.
[Route("/qualifications/{run}")] [Layout(OfficeFrame)] [Authorize(FollowsProcesses)] [Render(CSR)] [Title("A qualification")]
component QualificationPage(Guid run) {
  render {
    Stack(gap: 5, px: 5, py: 6, w: "100%", maxW: "980px", mx: "auto") {
      Row { TextLink("All qualifications", to: "/"); }
      ProcessRunInspector(run);
    }
  }
}

/// One piece of an agent's work — and, with a step's number, that step marked.
[Route("/work/{task}/{step}")] [Layout(OfficeFrame)] [Authorize(UsesAgents)] [Render(CSR)] [Title("An agent's work")]
component WorkPage(Guid task, int step) {
  render {
    Stack(gap: 5, px: 5, py: 6, w: "100%", maxW: "980px", mx: "auto") {
      Row { TextLink("All qualifications", to: "/"); }
      WorkInspector(task, step: step);
    }
  }
}

/// "Correct this", from the teaching kit, under the record of every piece of work.
[Contribution("Teaching", Order = 50)]
component TeachHere(Guid task) : AgentWorkPanel {
  render { WorkTeaching(task, beside: true); }
}
