// The station's agent, its model, and where a piece of work is shown. In a file of its own with no `namespace`,
// because an `app.X = …` statement's value is resolved outside the file's namespace.
using Osysharp.Agents;
using Osysharp.Agents.Inspector;
using Osysharp.Llm;
using Station;

app.Llm = new LlmSetup {
  Models = [
    new LlmModel { Name = "Small", Client = new ScriptedModel { Name = "Small" }, Model = "scripted-small",
                   Price = new LlmPrice { Input = 1, Output = 5 }, MaxOutputTokens = 1000 },
  ],
  Default = "Small",
};

app.Agents = new AgentsSetup { Agents = [new Forecaster()], TaskBudget = 0.05m };

app.AgentInspector = new AgentInspectorSetup { WorkPage = "/work/{task}" };
