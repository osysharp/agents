// The producer's test project for Osysharp.Agents.Management — a film archive that takes reels into its collection
// with the help of five agents. A registrar takes a reel in and hands its condition and its rights to a specialist
// each; the condition checker may not quarantine a reel alone, so that waits for a person; the rights clerk has a
// small allowance and runs out; the describer has a limit for a day and reaches it; the transcriber is paused. The
// head of collections runs them all from the management screens. No model is ever called: its one model is scripted.
app FilmArchive {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Agents@1;
  use Osysharp.Agents.Testing@1;
  use Osysharp.Agents.Teaching@1;
  use Osysharp.Agents.Inspector@2;
  use Osysharp.Agents.HumanRequests@1;
  use Osysharp.Agents.Management@2;
  use Osysharp.HumanRequests@1;
  use Osysharp.WorkQueues@1;
  use Osysharp.Llm@2;
  use Osysharp.Identity@0;
  use Osysharp.Organizations@0;
  use Osysharp.Organizations.ServicePlans@0;
  use Osysharp.Presence@0;
  use Osysharp.Observability;
  use Osysharp.Workflow;
  use Osysharp.ServiceHours;
  use Osysharp.Ui;
}
