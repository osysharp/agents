// Osysharp.Agents.Management — the place a person runs an app's agents from.
//
//     /// Three routes, and the whole of it is there:
//     [Route("/agents")]                 component Agents()                              { render { AgentsManagement(); } }
//     [Route("/agents/{section}")]       component AgentsSection(string section)         { render { AgentsManagement(section); } }
//     [Route("/agents/{section}/{id}")]  component AgentsItem(string section, string id) { render { AgentsManagement(section, id); } }
//
//     /// …or one screen alone, on a page of your own:
//     AgentRoster();  AgentProfilePage(agent);  AgentWorkList();  AgentWorkDetail(task);
//     PeopleAgentsWaitOn();  AgentStandingRules();  AgentSpending();  AgentRoles();
//
//     /// …and wherever the app draws `WorkInspector`, what a person in charge does to that piece of work is under it:
//     /// call it off, try it again, hand it to a person.
//
// ⚑ THE SCREENS DECIDE NOTHING. Who reads a piece of work, who pauses an agent, who names its sponsor, who stops work,
//   who takes a standing rule back is `Osysharp.Agents`' to say (`SupervisesAgents`, `PausesAgents`, `SponsorsAgents`,
//   `ReadsAllAgentWork` and the rest); a control somebody may not use is not offered, and one that is refused says
//   why, in the kit's own words.
//
// ⚑ EVERY FIGURE IS READ FROM THE RECORDS: the receipts of the work, the meter's count against each limit, the
//   corrections people made. Nothing on these screens asks a model anything.
package Osysharp.Agents.Management {
  version     "1.2.0";
  minPlatform "0.14.0";
  summary     "the screens a person runs an app's AI agents from: every agent with who answers for it, what it does alone, proposes and never does, its skills, the specialists it hands work to, what it has spent of its limits, how often people corrected it, and Pause and Resume with the reason; all the agents' work, filtered by agent, state, person, time and what it was charged to, each piece with its tree, what it waits for, its steps and Stop; everybody the agents are waiting on, for how long; every standing rule with who gave it, how often it has been used and Take back; what was spent by agent, skill, person and charge against each limit, and what a limit stopped; and who may do what.";

  model "model/**/*.osy";
  tests "tests";
  use Osysharp.Agents@1;
  use Osysharp.Agents.Teaching@1;
  use Osysharp.Agents.Inspector@1;
  use Osysharp.Agents.HumanRequests@1;
  use Osysharp.HumanRequests@1;
  use Osysharp.WorkQueues@1;
  use Osysharp.Llm@2;
  use Osysharp.Identity@0;
  use Osysharp.Workflow;
  use Osysharp.ServiceHours;
  use Osysharp.Observability;
  use Osysharp.Ui;
}
